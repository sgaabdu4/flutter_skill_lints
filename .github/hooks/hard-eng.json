{
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" session copilot",
        "timeoutSec": 3600
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" tool copilot",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" failure copilot",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 \"$(git rev-parse --show-toplevel)/.hooks/hard-eng.py\" stop copilot",
        "timeoutSec": 3600
      }
    ]
  },
  "version": 1
}
