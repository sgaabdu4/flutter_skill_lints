{
  "version": 1,
  "packages": [
    {
      "name": ".",
      "path": ".",
      "language": "dart",
      "sources": [
        "lib"
      ],
      "checks": [
        {
          "name": "security",
          "role": "security",
          "parallel": true,
          "command": [
            "semgrep",
            "scan",
            "--config",
            ".agents/skills/he/security",
            "--jobs",
            "2",
            "--error",
            "--strict",
            "--time",
            "--json",
            "--output",
            "coverage/semgrep.json",
            "."
          ],
          "report": {
            "type": "semgrep",
            "path": "coverage/semgrep.json"
          }
        },
        {
          "name": "vulnerabilities",
          "role": "vulnerabilities",
          "parallel": true,
          "command": [
            "osv-scanner",
            "scan",
            "source",
            "--lockfile=pubspec.lock",
            "--all-packages",
            "--format=json",
            "--output-file=coverage/osv.json"
          ],
          "report": {
            "type": "osv",
            "path": "coverage/osv.json"
          }
        },
        {
          "name": "lockfile",
          "role": "lockfiles",
          "command": [
            "dart",
            "pub",
            "get",
            "--enforce-lockfile"
          ]
        },
        {
          "name": "format",
          "role": "format",
          "parallel": true,
          "command": [
            "dart",
            "format",
            "--output=none",
            "--set-exit-if-changed",
            "."
          ]
        },
        {
          "name": "types-lint",
          "role": "types",
          "parallel": true,
          "command": [
            "dart",
            "analyze",
            "--fatal-infos",
            "."
          ]
        },
        {
          "name": "import-boundaries",
          "role": "boundaries",
          "command": [
            "dart-decimate",
            "check",
            ".",
            "--boundary-violations",
            "--strict"
          ]
        },
        {
          "name": "tests",
          "role": "tests",
          "command": [
            "dart",
            "run",
            "coverage:test_with_coverage",
            "--branch-coverage",
            "--",
            "--file-reporter=json:coverage/tests.jsonl"
          ],
          "report": {
            "type": "dart-tests",
            "tests": "coverage/tests.jsonl",
            "coverage": "coverage/lcov.info",
            "stdout": false
          }
        },
        {
          "name": "dead-code-duplicates",
          "role": "dead-code-duplicates",
          "command": [
            "dart-decimate",
            "check",
            ".",
            "--threshold",
            "0",
            "--format",
            "json",
            "--strict"
          ],
          "report": {
            "type": "dart-decimate",
            "path": "coverage/dart-decimate.json",
            "stdout": true
          }
        },
        {
          "name": "performance",
          "role": "performance",
          "command": [
            "dart",
            "test",
            "test/performance",
            "--reporter=json"
          ],
          "report": {
            "type": "performance-dart",
            "path": "coverage/performance.jsonl",
            "stdout": true
          }
        }
      ]
    }
  ],
  "shared": [
    {
      "name": "secrets-files",
      "role": "secrets-files",
      "parallel": true,
      "command": [
        "gitleaks",
        "dir",
        ".",
        "--redact=100",
        "--no-banner",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-files.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-files.sarif"
      }
    },
    {
      "name": "secrets-history",
      "role": "secrets-history",
      "parallel": true,
      "command": [
        "gitleaks",
        "git",
        ".",
        "--redact=100",
        "--no-banner",
        "--log-opts=--all",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-history.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-history.sarif"
      }
    },
    {
      "name": "actionlint",
      "role": "workflows",
      "parallel": true,
      "command": [
        "actionlint",
        "-no-color"
      ]
    },
    {
      "name": "zizmor",
      "role": "ci-security",
      "parallel": true,
      "command": [
        "zizmor",
        "--strict-collection",
        "--persona=auditor",
        "--format=plain",
        "."
      ]
    }
  ],
  "shipping": {
    "base": "main",
    "checks": [
      "Check Version Consistency",
      "Run Flutter Plugin Smoke",
      "Run Dart Tests",
      "Analyze Code",
      "Check Formatting",
      "Package Analysis",
      "Publish Dry Run"
    ],
    "ui_paths": [],
    "ci_seconds": 600,
    "pre_push_seconds": 180,
    "delivery": []
  }
}
